{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coconut",
  "version": "0.2.0",
  "identifier": "com.coconut.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "coconut",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "maximizable": true,
        "closable": true,
        "minimizable": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DESKTOP/**", "$DOWNLOAD/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first Markdown editor",
    "longDescription": "Local-first WYSIWYG Markdown editor. The file on disk is the source of truth; double-click to open.",
    "copyright": "Copyright (C) coconut contributors. Licensed under GPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
